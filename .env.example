# API Environment Variables
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://bizexpert:bizexpert_dev@localhost:5440/bizexpert

# JWT
JWT_SECRET=change_me_in_production_use_long_random_string
JWT_EXPIRES_IN=7d

# Redis (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=bizexpert
REDIS_PASSWORD=bizexpert_dev
REDIS_TLS=false

# WhatsApp (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_APP_SECRET=your_meta_app_secret

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o

# Resend (signup OTP)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=BizExpert <noreply@bizexpert.app>

# App
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

